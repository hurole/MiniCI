# 基础服务配置
PORT=3001
NODE_ENV=development

# 数据库连接 (SQLite)
DATABASE_URL="file:./prisma/data/dev.db"

# Gitea OAuth 配置 (用于第三方登录与仓库集成)
GITEA_URL="https://your-gitea-instance.com"
GITEA_CLIENT_ID="your_gitea_oauth_client_id"
GITEA_CLIENT_SECRET="your_gitea_oauth_client_secret"
GITEA_REDIRECT_URI="http://localhost:3000/login"

# 日志级别 (debug, info, warn, error)
LOG_LEVEL="debug"

# CI 流水线工作空间目录
PIPELINE_WORKSPACE="/tmp/minici/workspace"
